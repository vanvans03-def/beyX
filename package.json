{
  "name": "bey-x",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3333",
    "dev-local": "next dev -p 3334",
    "gcp:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup/Start-GcpTunnel.ps1",
    "setup:local-gcp": "node scripts/setup/connect-local-gcp.mjs",
    "build": "next build",
    "start": "next start -p 3333",
    "lint": "eslint",
    "test": "npm run test:functional",
    "test:minigame": "node scripts/testing/beyblade-game.test.mjs",
    "test:functional": "node scripts/testing/test-server-harness.cjs",
    "test:functional:postgres": "node scripts/testing/run-postgres-functional.cjs",
    "test:functional:headed": "node scripts/testing/test-server-harness.cjs --headed",
    "test:load": "node scripts/performance/capacity-test.mjs",
    "test:realtime": "node scripts/performance/realtime-capacity.mjs",
    "backup:postgres": "node scripts/backup/create-encrypted-backup.cjs",
    "restore:postgres": "node scripts/backup/restore-encrypted-backup.cjs",
    "test:predeploy": "npm run build && npm run test:functional && npm run test:load",
    "test:e2e:migration": "node scripts/testing/run-migration-e2e.mjs",
    "test:e2e:ui": "node scripts/testing/run-migration-e2e.mjs --ui",
    "test:e2e:challonge": "node scripts/testing/run-migration-e2e.mjs --challonge",
    "test:e2e:list": "playwright test -c playwright.migration.config.ts --list",
    "test:e2e:inventory": "node scripts/testing/e2e-route-inventory.mjs",
    "test:e2e:report": "playwright show-report playwright-report/migration",
    "test:e2e:compare": "node scripts/testing/compare-e2e-reports.mjs",
    "test:e2e:tools": "node --test scripts/testing/compare-e2e-reports.test.mjs",
    "test:brackets": "node --test scripts/testing/bracket-invariants.test.mjs",
    "setup:local-db-env": "node scripts/setup/generate-local-db-env.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "@types/ioredis": "^4.28.10",
    "@vercel/blob": "^2.0.0",
    "@vercel/postgres": "^0.10.0",
    "@xyflow/react": "^12.10.2",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dom-to-image": "^2.6.0",
    "google-auth-library": "^10.5.0",
    "google-spreadsheet": "^5.0.2",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "ioredis": "^6.0.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "pg": "^8.17.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-zoom-pan-pinch": "^3.7.0",
    "sharp": "^0.35.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "three": "^0.186.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/html2canvas": "^0.5.35",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.3",
    "@types/three": "^0.186.0",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
