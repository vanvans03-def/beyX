[Unit]
Description=BeyX private off-VM PostgreSQL backup
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/opt/beyx
ExecStart=/bin/bash /opt/beyx/deploy/gcp/backup-database.sh beyx_prod_20261020
NoNewPrivileges=true
