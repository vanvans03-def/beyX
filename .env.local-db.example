# Copy to .env.local-db and replace every placeholder before starting PostgreSQL.
# Never commit .env.local-db.

LOCAL_POSTGRES_DB=beyx
LOCAL_POSTGRES_ADMIN_USER=beyx_admin
LOCAL_POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
LOCAL_POSTGRES_APP_PASSWORD=replace-with-a-different-long-random-app-password
LOCAL_POSTGRES_BACKUP_PASSWORD=replace-with-a-different-long-random-backup-password
LOCAL_POSTGRES_PORT=5432
LOCAL_POSTGRES_BACKUP_DIR=./backups

# Generate at least 32 random bytes. This will replace SUPABASE_JWT_SECRET.
APP_SESSION_SECRET=replace-with-a-long-random-session-secret

