# Copy this file to .env.local for local development
# Or set these as environment variables in docker-compose.yml / server

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
APP_SESSION_SECRET=replace_with_at_least_32_random_characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATA_BACKEND=supabase
AUTH_BACKEND=local
REALTIME_BACKEND=supabase
DATABASE_URL=
DATABASE_SSL=disable
NEXT_PUBLIC_BUILD_ID=v1.0.0

# Redis Cache (Optional: defaults to redis://redis:6379 in Docker)
REDIS_URL=redis://localhost:6379
