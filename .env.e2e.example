# Copy to .env.e2e (git-ignored). Never point at production.
# Restore your application schema/migrations into this disposable database first.
E2E_DATABASE_URL=postgresql://beyx_test:replace_me@127.0.0.1:5432/beyx_e2e
E2E_DATABASE_NAME=beyx_e2e
E2E_ALLOW_WRITES=1
E2E_DATABASE_SSL=disable
# Direct URL for LISTEN/NOTIFY if the main URL is transaction-pooled.
E2E_REALTIME_DATABASE_URL=
E2E_PORT=3345
# Optional live comparison, exclusively a Challonge test account.
E2E_CHALLONGE_USERNAME=
E2E_CHALLONGE_API_KEY=
E2E_CHALLONGE_SIZES=3,4,5,8,9,16
